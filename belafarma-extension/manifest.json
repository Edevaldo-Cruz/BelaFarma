{
  "manifest_version": 3,
  "name": "BelaFarma - WhatsApp Vendas Integrador",
  "version": "1.0.0",
  "description": "Integração do WhatsApp Web oficial com o painel de CRM da BelaFarma em janela flutuante.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.drogariabelafarma.com.br/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "action": {},
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://app.drogariabelafarma.com.br/*",
        "https://127.0.0.1/*",
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": ["crm-bridge.js"],
      "run_at": "document_end"
    }
  ]
}
