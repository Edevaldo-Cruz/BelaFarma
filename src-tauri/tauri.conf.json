{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BelinhaPDV",
  "version": "5.0.0",
  "identifier": "com.belafarma.pdv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/?app=pdv",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Belinha PDV - Frente de Caixa Fiscal | Drogaria Bela Farma Sul",
        "url": "http://192.168.1.70:8085/?app=pdv",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": true,
        "maximized": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
